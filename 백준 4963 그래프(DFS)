import java.util.Scanner;


class Main {	
    static boolean visited[][];
    static int arr[][];
    static int dx[] = {0, 1, 0, -1, 1, -1, 1, -1}; //x축
    static int dy[] = {1, 0, -1, 0, 1, -1, -1, 1}; //y축
    static int N;
    static int M;

	public static void main (String[] args) {
		  Scanner sc = new Scanner(System.in);
		  while(true) {
			  int count = 0;
			  M = sc.nextInt();
			  N = sc.nextInt();
			  if(N==0 && M==0) {
				  break;
			  }else {
				  arr = new int[N][M];
				  visited = new boolean[N][M];
				  for(int i=0; i<N; i++) {
					  for(int j=0; j<M; j++) {
						  arr[i][j] = sc.nextInt();
					  }
				  }
				  
				  for(int i=0; i<N; i++) {
					  for(int j=0; j<M; j++) {
						  if(!visited[i][j] && arr[i][j]==1) {
							  count++;
							  DFS(i,j);
						  }
					  }
				  }
			  }
			  System.out.println(count);
		  }
    }

	    
	static void DFS(int x,int y) {
		if(visited[x][y]) {
			return;
		}
		
		visited[x][y] = true;
		for (int i=0; i<8; i++) {
			int nx = x+dx[i];
			int ny = y+dy[i];
			
			if (nx>=0 && ny>=0 && nx<N && ny<M) {
				if(!visited[nx][ny] && arr[nx][ny]==1) {
					DFS(nx,ny);
				}
			}
		}
    }
}
