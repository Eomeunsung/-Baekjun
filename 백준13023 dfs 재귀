import java.io.*;
import java.util.*;

public class Main {
    static Boolean flag[];
    static ArrayList<Integer> arr[];
    static int N;
    static int M;
    static Boolean fl = false;
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
//        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
        Scanner sc = new Scanner(System.in);

        N = sc.nextInt();
        M = sc.nextInt();
        arr = new ArrayList[N];
        flag = new Boolean[N];

        for(int i=0; i<flag.length; i++){
            flag[i] = false;
        }


        for(int i=0; i<arr.length; i++){
            arr[i] = new ArrayList<>();
        }
        for(int i=0; i<M; i++){
            int x = sc.nextInt();
            int y = sc.nextInt();
            arr[x].add(y);
            arr[y].add(x);
        }

        for(int i=0; i<arr.length; i++){
            dfs(i, 1);
            if(fl){
                System.out.println(1);
                return;
            }
        }

        if(fl){
            System.out.println(1);
        }else{
            System.out.println(0);
        }



    }

    static void dfs(int i, int depth) {
        if(depth>=5){
            fl = true;
            return;
        }
        flag[i] = true;
        for(int k : arr[i]){
            if(!flag[k]){
                dfs(k, depth+1);
            }
        }
        flag[i] = false;
    }
}

