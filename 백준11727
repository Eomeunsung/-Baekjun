        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();
        int dp[] = new int[N+1];

        dp[0] =1;
        dp[1] = 1;


        for(int i=2; i<N+1; i++){
            dp[i] = (dp[i-1]+2*dp[i-2])%10007;
        }

