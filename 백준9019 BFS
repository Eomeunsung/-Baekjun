import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.LinkedList;
import java.util.Queue;

class Edge {
    int v;
    String str;

    public Edge(int v, String str) {
        this.v = v;
        this.str = str;
    }
}

public class Main {
    static Queue<Edge> que;
    static boolean[] flag;
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
//        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
//        Scanner sc = new Scanner(System.in);


        int T = Integer.parseInt(br.readLine());

        for(int i=0; i<T; i++){
            que = new LinkedList<>();
            String str[] = br.readLine().split(" ");
            int A = Integer.parseInt(str[0]);
            int B = Integer.parseInt(str[1]);
            que.add(new Edge(A, ""));
            flag = new boolean[10000];
            flag[A] = true;
            BFS(B);
        }
    }


    static void BFS(int B){
        while(!que.isEmpty()){
            Edge edge = que.poll();
            if(edge.v == B){
                System.out.println(edge.str);
                return;
            }
            D(edge);
            S(edge);
            L(edge);
            R(edge);
        }
    }

    static void D(Edge edge){
        int V = edge.v;
        V = (V * 2) % 10000;
        if(!flag[V]){
            que.add(new Edge(V, edge.str+"D"));
            flag[V] = true;
        }
    }

    static void S(Edge edge){
        int V = edge.v == 0 ? 9999 : edge.v - 1;
        if(!flag[V]){
            que.add(new Edge(V, edge.str+"S"));
            flag[V] = true;
        }
    }

    static void L(Edge edge){
        int V = edge.v;
        V = V % 1000 * 10 + V / 1000;
        if(!flag[V]){
            que.add(new Edge(V, edge.str+"L"));
            flag[V] = true;
        }
    }

    static void R(Edge edge){
        int V = edge.v;
        V = V % 10 * 1000 + V / 10;
        if(!flag[V]){
            que.add(new Edge(V, edge.str+"R"));
            flag[V] = true;
        }
    }


}
