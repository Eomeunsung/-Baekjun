import java.io.IOException;
import java.util.Scanner;


public class Main {

    public static void main(String[] args) throws IOException {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        int M = sc.nextInt();

        int sum[] = new int[N+1];

        sum[0] = 0;
        sum[1] = sc.nextInt();
        for(int i=2; i<N+1; i++){
            int n = sc.nextInt();
            sum[i] = sum[i-1] + n;
        }


        for(int i=0; i<M; i++){
            int k = sc.nextInt();
            int m = sc.nextInt();
            System.out.println(sum[m]-sum[k-1]);
        }
    }

}
