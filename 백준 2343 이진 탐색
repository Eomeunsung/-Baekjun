import java.util.Arrays;
import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int N = sc.nextInt();
		int M = sc.nextInt();
		int arr[] = new int[N];
		
		int end = 0;
		int start = 0;
		for(int i=0; i<arr.length; i++) {
			arr[i] = sc.nextInt();
			
			end += arr[i];
			if(start<arr[i]) {
				start = arr[i];
			}
		}
		
		while(start <= end) {
			int mid = (start + end)/2;
			int sum=0;
			int count = 0;
		
			for(int i=0; i<N; i++) {
				if(arr[i]+sum > mid) {
					count++;
					sum=0;
				}
				sum += arr[i];
			}
			
			if(sum!=0) {
				count++;
			}
			if(count>M) {
				start = mid+1;
			}else if(count<=M) {
				end = mid-1;
			}
		}
		System.out.println(start);
	}

}
