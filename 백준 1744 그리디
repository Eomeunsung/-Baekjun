import java.util.Collections;
import java.util.PriorityQueue;
import java.util.Scanner;

public class Main {

	public static void main(String[] args) throws Exception {
		Scanner sc = new Scanner(System.in);
		PriorityQueue<Integer> pq = new PriorityQueue<>(Collections.reverseOrder()); //오름차순
		PriorityQueue<Integer> mq = new PriorityQueue<>();
		int N = sc.nextInt();
		int zero = 0;
		int one = 0;
		for(int i=0; i<N; i++) {
			int s = sc.nextInt();
			if(s>1) {
				pq.add(s);
			}else if(s==0){
				zero++;
			}else if(s==1) {
				one++;
			}else {
				mq.add(s);
			}
		}
		int sum = 0;
		while(pq.size()>1) { // 1보다 클때까지
			int data1 = pq.remove();
			int data2 = pq.remove();
			
				
			sum = sum+ data1*data2;
		}
		if(!pq.isEmpty()) {
			sum=sum+pq.remove();
		}
		
		
		while(mq.size()>1) {
			int data1 = mq.remove();
			int data2 = mq.remove();
			
			sum = sum+data1*data2;
		}
		if(!mq.isEmpty()) {
			if(zero==0) {
				sum = sum+ mq.remove();
			}
			
		}
		sum = sum+one;
		
		System.out.println(sum);
	}

}
