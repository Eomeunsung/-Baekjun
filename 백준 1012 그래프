import java.util.ArrayList;
import java.util.Arrays;
import java.util.LinkedList;
import java.util.Queue;
import java.util.Scanner;

public class Main {
	static boolean visited[][];
	static int arr[][];
	static int dx[] = {0, 1, 0, -1}; //x축
	static int dy[] = {1, 0, -1, 0}; //y축
	static int N;
	static int M;

	public static void main(String[] args){
		Scanner sc = new Scanner(System.in);
		int T = sc.nextInt();
		
		for(int p=0; p<T; p++) {
			int count = 0;
			M = sc.nextInt();
			N = sc.nextInt();
			int K = sc.nextInt();
			arr = new int[N][M];
			visited = new boolean[N][M];
			for(int i=0; i<K; i++) {
				int x = sc.nextInt();
				int y = sc.nextInt();
				arr[y][x] = 1;
				visited[y][x] = true;
			}
			
			for(int i=0; i<N; i++) {
				for(int j=0; j<M; j++) {
					if(visited[i][j]) {
						count++;
						BFS(i,j);
					}
				}
			}
			System.out.println(count);
		}
	}
	
	public static void BFS(int i, int j) {
		Queue<int []> q = new LinkedList<>();
		q.offer(new int[] {i, j});
		
		visited[i][j] = false;
		
		while(!q.isEmpty()) {
			int now[] = q.poll();
			for(int k=0; k<4; k++) {
				int x = now[0] + dx[k];
				int y = now[1] + dy[k];
				
				if(x>=0 && y>=0 && x<N && y<M) {
					if (visited[x][y]) {
						visited[x][y] = false;
		                q.offer(new int[]{x, y});
		           }
				}
			}
		}
		
	}
	
}
