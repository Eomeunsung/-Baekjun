import java.io.*;
import java.util.*;


public class Main {

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
//        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
//        Scanner sc = new Scanner(System.in);
        int N = Integer.parseInt(br.readLine());
        myData[] arr = new myData[N+1];
        int index[] = new int[N+1];

        for(int i=1; i<N+1; i++){
            int n = Integer.parseInt(br.readLine());
            arr[i] = new myData(n,i);
        }

        myData[] arr2 = new myData[N+1];
        for(int i=1; i<N+1; i++){

            arr2[i] = new myData(arr[i].value, arr[i].index);
        }

        Arrays.sort(arr, 1, N+1, Comparator.comparingInt(o->o.value));

        for(int i=1; i<arr.length; i++){

            index[i] = arr[i].index-arr2[i].index;

        }

        int max = 0;
        for(int i=0; i<arr.length; i++){
            if(max<index[i]){
                max = index[i];
            }
        }
        System.out.println(max+1);
    }

}
class myData{
    int value;
    int index;

    public myData(int value, int index) {
        this.value = value;
        this.index = index;
    }

}
