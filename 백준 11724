import java.util.ArrayList;
import java.util.Scanner;

public class Main {
	static ArrayList<Integer> []arr;
	static boolean visited[];
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int N = sc.nextInt();
		int M = sc.nextInt();
		
		arr = new ArrayList[N+1];
		visited = new boolean[N+1];
		
		for(int i=1; i<N+1; i++) {
			arr[i] = new ArrayList<Integer>();
		}
		
		for(int i=0; i<M; i++) { //입력받은 값 어레이 리스트 트리 형태로 받기
			int s = sc.nextInt();
			int e = sc.nextInt();
			
			arr[s].add(e);
			arr[e].add(s);
		}
	
		int count = 0;
		for(int i=1; i<N+1; i++) { 
			if(!visited[i]) {
				count++;
				DFS(i);
			}
		}
		System.out.println(count);
		
	}
	static void DFS(int v){
		if(visited[v]) {
			return;
		}
		
		visited[v] = true;
		for(int i : arr[v]) {
			if(visited[i] == false) {
				DFS(i);
			}
		}
	}

}
