import java.io.*;
import java.util.*;

public class Main {
    static Boolean flag[];
    static TreeSet<Integer> arr[];
    static int N;
    static int M;
    static int V;
    static Queue<Integer> que = new LinkedList<>();
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
//        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
        Scanner sc = new Scanner(System.in);

        N = sc.nextInt();
        M = sc.nextInt();
        V = sc.nextInt();

        arr = new TreeSet[N+1];

        for(int i=0; i<arr.length; i++){
            arr[i] = new TreeSet<>();
        }

        for(int i=0; i<M; i++){
            int x = sc.nextInt();
            int y = sc.nextInt();
            arr[x].add(y);
            arr[y].add(x);
        }
        flag = new Boolean[N+1];
        for(int i=0; i< flag.length; i++){
            flag[i] = false;
        }
        flag[V] = true;
        DFS(V);
        System.out.println();

        flag = new Boolean[N+1];
        for(int i=0; i< flag.length; i++){
            flag[i] = false;
        }
        que.add(V);
        BFS();


    }

    static void DFS(int i) {
        System.out.print(i+" ");
        flag[i] = true;
        for(int k : arr[i]){
            if(!flag[k]){
                DFS(k);
            }
        }
    }

    static void BFS(){
        while (!que.isEmpty()){

            int n = que.poll();
            if(flag[n]){
                continue;
            }
            flag[n] = true;
            System.out.print(n+" ");
            for(int i : arr[n]){
//                System.out.println("que "+n+" "+i);
                if(!flag[i]){
                    flag[n] = true;
                    que.add(i);
                }
            }
        }
    }
}

